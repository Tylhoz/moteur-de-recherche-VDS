# Server-only names. This file is NOT loaded automatically.
# Inject real values through the hosting secret manager. Never use VITE_* for secrets.
# Empty configuration fails closed. No real credentials or private paths are included.

VDS_API_BEARER_SHA256=
VDS_API_PORT=8787
VDS_ALLOWED_ORIGIN=

# Portal source: none | private_native_read | google_sheets
VDS_PORTAL_PROVIDER=none
VDS_PRIVATE_DATA_ROOT=
VDS_NATIVE_READ_FILE=
VDS_PILOT_FILE=
VDS_IDENTITY_BASELINE_FILE=
VDS_SYNC_JOURNAL_FILE=

# Portal OAuth identity: exactly the Sheets readonly scope.
VDS_GOOGLE_CLIENT_ID=
VDS_GOOGLE_CLIENT_SECRET=
VDS_GOOGLE_REFRESH_TOKEN=

# Separate canonical 17-table API: none | private_file | google_sheets
VDS_DATA_PROVIDER=none
VDS_PRIVATE_DATA_FILE=
VDS_SHEETS_MANIFEST=
VDS_GOOGLE_ACCESS_TOKEN=

# Optional private-data tests. Keep all inputs outside this repository.
VDS_REAL_CHAIN_DATA_ROOT=
VDS_PILOT_UI_DATA=
VDS_PILOT_AUDIT_TEST_INPUT=

# The hosting entrypoint must supply createWebGateway options separately:
# authenticate, api, staticRoot, internalBearer, publicOrigin.
# No login, TLS listener or verified hosting-session callback is configured here.

# Exact authorized workbook ID; server/offline export only, never VITE_* or Git.
VDS_LEGACY_SPREADSHEET_ID=
